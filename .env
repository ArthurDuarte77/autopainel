# =====================================================================
# AutoPainel — variáveis de ambiente
# Copie para .env e preencha. Campos vazios = integração desativada.
# =====================================================================

# ---------- Aplicação ----------
TZ=America/Sao_Paulo
WEB_PORT=8080
# URL pública do sistema (usada nos redirects OAuth e webhooks)
PUBLIC_URL=http://localhost:8080
API_PORT=3000
JWT_SECRET=troque-este-segredo
# Usuário administrador criado no primeiro boot
ADMIN_NAME=Pedro Martins
ADMIN_EMAIL=admin@autopainel.local
ADMIN_PASSWORD=admin123
STORE_NAME=Loja Centro

# ---------- Banco MySQL ----------
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=autopainel
MYSQL_USER=autopainel
MYSQL_PASSWORD=autopainel
MYSQL_HOST_PORT=3307

# ---------- E-mail (envio ao contador) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AutoPainel <no-reply@autopainel.local>
ACCOUNTANT_EMAIL=

# ---------- FIPE (https://deividfortuna.github.io/fipe/) ----------
FIPE_API_URL=https://fipe.parallelum.com.br/api/v2
# Token opcional (aumenta limite de requisições)
FIPE_TOKEN=

# ---------- Consulta de placa (ex.: apiplacas.com.br / wdapi2) ----------
PLATE_API_URL=https://wdapi2.com.br/consulta
PLATE_API_TOKEN=

# =====================================================================
# MARKETPLACES
# =====================================================================

# ---------- Mercado Livre (https://developers.mercadolivre.com.br) ----------
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Redirect a cadastrar no app: {PUBLIC_URL}/api/integrations/mercadolivre/callback
ML_SITE_ID=MLB
# Categoria de carros (MLB1744 = Carros e Caminhonetes)
ML_CATEGORY_ID=MLB1744
ML_LISTING_TYPE=gold_premium

# ---------- OLX (https://developers.olx.com.br) ----------
OLX_CLIENT_ID=
OLX_CLIENT_SECRET=
# Redirect: {PUBLIC_URL}/api/integrations/olx/callback
OLX_API_URL=https://apps.olx.com.br
OLX_AUTH_URL=https://auth.olx.com.br
OLX_WEBHOOK_TOKEN=

# =====================================================================
# SITE PRÓPRIO / E-COMMERCE
# =====================================================================

# ---------- Tray (https://developers.tray.com.br) ----------
TRAY_CONSUMER_KEY=
TRAY_CONSUMER_SECRET=
# URL da API da loja, ex.: https://www.sualoja.com.br/web_api
TRAY_API_ADDRESS=
# Code gerado na instalação do app na loja
TRAY_CODE=

# ---------- Nuvemshop (https://tiendanube.github.io/api-documentation) ----------
NUVEMSHOP_CLIENT_ID=
NUVEMSHOP_CLIENT_SECRET=
NUVEMSHOP_STORE_ID=
NUVEMSHOP_ACCESS_TOKEN=

# ---------- Shopify ----------
# ex.: minha-loja.myshopify.com
SHOPIFY_SHOP=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-01

# ---------- WooCommerce ----------
WOOCOMMERCE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=

# ---------- Loja Integrada ----------
LOJA_INTEGRADA_API_KEY=
LOJA_INTEGRADA_APP_KEY=

# ---------- Site próprio (webhook genérico) ----------
# O sistema faz POST/DELETE do veículo em JSON nesta URL
SITE_WEBHOOK_URL=
SITE_WEBHOOK_SECRET=

# =====================================================================
# CRMs
# =====================================================================

# ---------- RD Station CRM (https://developers.rdstation.com) ----------
RDSTATION_CRM_TOKEN=
# RD Station Marketing (conversões)
RDSTATION_MARKETING_API_KEY=

# ---------- HubSpot (Private App token) ----------
HUBSPOT_ACCESS_TOKEN=

# ---------- Pipedrive ----------
PIPEDRIVE_API_TOKEN=
# ex.: minhaempresa (de minhaempresa.pipedrive.com)
PIPEDRIVE_COMPANY_DOMAIN=

# ---------- Salesforce (OAuth username-password flow) ----------
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_SECURITY_TOKEN=

# ---------- Bitrix24 (webhook de entrada) ----------
# ex.: https://minhaempresa.bitrix24.com.br/rest/1/xxxxxxxx/
BITRIX24_WEBHOOK_URL=

# ---------- Zoho CRM ----------
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# ---------- Ploomes ----------
PLOOMES_USER_KEY=

# ---------- Agendor ----------
AGENDOR_API_TOKEN=

# ---------- WhatsApp Cloud API (Meta) — notificações a clientes ----------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=autopainel
